<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.continew.admin.wework.mapper.ApprovalTemplateMapper">
    <!-- 通用查询映射结果 -->
    <!-- 在resultMap中添加typeHandler -->
    <resultMap id="BaseResultMap" type="top.continew.admin.wework.model.entity.ApprovalTemplateDO">
        <id column="id" property="id"/>
        <result column="template_id" property="templateId"/>
        <result column="template_name" property="templateName"/>
        <result column="template_content" property="templateContent" typeHandler="top.continew.admin.wework.config.JsonTypeHandler"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>
</mapper>
